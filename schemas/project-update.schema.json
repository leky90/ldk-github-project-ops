{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.local/schemas/github-project-update.schema.json",
  "title": "GitHub Project Status Update",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "projectId", "status", "summary", "progress", "risks", "evidence", "nextActions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "mode": { "enum": ["preview", "publish"] },
    "projectId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["ON_TRACK", "AT_RISK", "OFF_TRACK", "INACTIVE", "COMPLETE"] },
    "summary": { "type": "string", "minLength": 1 },
    "progress": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "nextActions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "startDate": { "type": "string", "format": "date" },
    "targetDate": { "type": "string", "format": "date" }
  }
}
