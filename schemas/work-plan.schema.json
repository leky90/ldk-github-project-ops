{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ldktech.local/schemas/github-work-plan.schema.json",
  "title": "GitHub Project Work Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "mode", "project", "resources", "milestones", "issues"],
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "mode": { "enum": ["preview", "apply"] },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "number", "lifecycle"],
      "properties": {
        "owner": { "$ref": "#/$defs/nonEmpty" },
        "number": { "type": "integer", "minimum": 1 },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "shortDescription": { "type": "string" },
        "readme": { "type": "string" },
        "lifecycle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "completionCriteria"],
          "properties": {
            "mode": { "enum": ["bounded", "continuous"] },
            "completionCriteria": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "kind", "url"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "title": { "$ref": "#/$defs/nonEmpty" },
          "kind": { "enum": ["brief", "prd", "technical-plan", "test-plan", "content-brief", "campaign-brief", "report", "reference"] },
          "url": { "type": "string", "format": "uri" }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "repository", "title"],
        "properties": {
          "key": { "$ref": "#/$defs/key" },
          "repository": { "$ref": "#/$defs/repository" },
          "title": { "$ref": "#/$defs/nonEmpty" },
          "description": { "type": "string" },
          "dueDate": { "$ref": "#/$defs/date" }
        }
      }
    },
    "issues": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/issue" }
    },
    "setup": { "$ref": "#/$defs/setup" },
    "estimation": { "$ref": "#/$defs/estimation" },
    "views": {
      "type": "array",
      "minItems": 6,
      "items": { "$ref": "#/$defs/view" }
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coverage" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "schemaVersion": { "const": 2 } }, "required": ["schemaVersion"] },
      "then": { "required": ["setup", "estimation", "views", "coverage"] }
    }
  ],
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "date": { "type": "string", "format": "date" },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ownerRole", "verification"],
      "properties": {
        "mode": { "enum": ["artifact-review", "publish", "external-action", "software-merge", "production-release", "operations-change"] },
        "ownerRole": { "$ref": "#/$defs/nonEmpty" },
        "target": { "type": "string" },
        "verification": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/nonEmpty" }
        }
      }
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "requiredFields", "workflows"],
      "properties": {
        "mode": { "enum": ["audit", "ensure", "preserve"] },
        "requiredFields": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["status", "role", "priority", "deliveryPhase", "estimate", "startDate", "targetDate", "iteration"] }
        },
        "workflows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "state"],
            "properties": {
              "name": { "enum": ["item-added", "closed-issue", "merged-pr", "auto-archive", "auto-add"] },
              "state": { "enum": ["enabled", "disabled", "preserve"] },
              "reason": { "$ref": "#/$defs/nonEmpty" }
            }
          }
        }
      }
    },
    "estimation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["none", "lightweight"] },
        "scale": { "const": "fibonacci" }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "layout", "visibleFields"],
      "properties": {
        "name": { "$ref": "#/$defs/nonEmpty" },
        "layout": { "enum": ["table", "board", "roadmap"] },
        "groupBy": { "$ref": "#/$defs/nonEmpty" },
        "filter": { "$ref": "#/$defs/nonEmpty" },
        "sortBy": { "$ref": "#/$defs/nonEmpty" },
        "visibleFields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "issueKeys"],
      "properties": {
        "requirement": { "$ref": "#/$defs/nonEmpty" },
        "issueKeys": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }
      }
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "repository", "title", "kind", "status", "role", "dor", "dod", "acceptanceCriteria", "delivery"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "repository": { "$ref": "#/$defs/repository" },
        "title": { "$ref": "#/$defs/nonEmpty" },
        "body": { "type": "string" },
        "kind": { "enum": ["outcome", "task", "decision"] },
        "issueType": { "$ref": "#/$defs/nonEmpty" },
        "parentKey": { "$ref": "#/$defs/key" },
        "status": { "enum": ["Refinement", "Ready", "Blocked"] },
        "role": { "$ref": "#/$defs/nonEmpty" },
        "reviewerRole": { "$ref": "#/$defs/nonEmpty" },
        "priority": { "enum": ["urgent", "high", "normal", "low", "none"] },
        "estimate": { "type": "number", "minimum": 0 },
        "estimateReason": { "$ref": "#/$defs/nonEmpty" },
        "iterationId": { "$ref": "#/$defs/nonEmpty" },
        "milestoneKey": { "$ref": "#/$defs/key" },
        "assignees": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "labels": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "dor": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "dod": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "acceptanceCriteria": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/nonEmpty" } },
        "delivery": { "$ref": "#/$defs/delivery" },
        "resourceKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "blockedByKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
        "relatedKeys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } }
      }
    }
  }
}
